# ---------------------------------------------------------------------------
# Déjà Vu configuration
# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# Groq — writes the grounded incident narrative.
# Leave empty and the app falls back to a deterministic template.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight — the long-term memory server.
# Local server:  hindsight-api   (see README)
# Cloud:         https://api.hindsight.vectorize.io
HINDSIGHT_API_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
DEJAVU_BANK=dejavu-oncall

# Hindsight extraction model (Ollama keeps it local and free).
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_MODEL=qwen3:4b-instruct
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:11434
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16000

# Band — the on-call room. Optional: with no keys the room transcript is
# rendered in the UI as a clearly-labelled local preview.
BAND_API_KEY=
BAND_CHAT_ID=
BAND_API_URL=https://app.band.ai

# Second Band identity for the critic. Falls back to BAND_API_KEY.
BAND_CRITIC_API_KEY=
BAND_AGENT_NAME=DejaVu-Recall
BAND_CRITIC_NAME=DejaVu-Critic

# The human the final handoff @mentions. Needed only for directed messages.
BAND_HUMAN_ID=
